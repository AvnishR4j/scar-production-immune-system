# Hindsight Cloud credentials. Leave empty to use the deterministic local demo.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=

# Groq credentials. Leave empty to use deterministic risk analysis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional dedicated HMAC secret for signing expiring demo sessions.
# Use a random value of at least 32 bytes in production.
SCAR_SESSION_SECRET=
